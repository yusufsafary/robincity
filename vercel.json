{
  "buildCommand": "pnpm --filter @workspace/robincity run build",
  "outputDirectory": "artifacts/robincity/dist/public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "framework": null,
  "env": {
    "BASE_PATH": "/",
    "NODE_ENV": "production",
    "SITE_URL": "https://cityhood.fun"
  },
  "rewrites": [
    {
      "source": "/((?!api|_next|favicon|sitemap|robots|.well-known|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
